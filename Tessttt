local function CreateToggle(text, setting)

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -8, 0, 55)
    Button.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Button

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -80, 1, 0)
    Label.Position = UDim2.fromOffset(14, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.new(1, 1, 1)
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.GothamMedium
    Label.Parent = Button

    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.fromOffset(55, 25)
    Status.Position = UDim2.new(1, -65, 0.5, -12)
    Status.BackgroundColor3 = Settings[setting]
        and Color3.fromRGB(70, 190, 110)
        or Color3.fromRGB(80, 80, 88)
    Status.Text = Settings[setting] and "ON" or "OFF"
    Status.TextColor3 = Color3.new(1, 1, 1)
    Status.TextSize = 11
    Status.Font = Enum.Font.GothamBold
    Status.Parent = Button

    local StatusCorner = Instance.new("UICorner")
    StatusCorner.CornerRadius = UDim.new(1, 0)
    StatusCorner.Parent = Status

    Button.Activated:Connect(function()

        Settings[setting] = not Settings[setting]

        Status.Text = Settings[setting] and "ON" or "OFF"

        Status.BackgroundColor3 =
            Settings[setting]
            and Color3.fromRGB(70, 190, 110)
            or Color3.fromRGB(80, 80, 88)

    end)

    return Button
end


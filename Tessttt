--==================================================
-- CHARACTER
--==================================================

local function GetRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")

end

--==================================================
-- DETECT STORM
--==================================================

local StormNames = {
    "Lightning",
    "Thunder",
    "Storm",
    "Thunderstorm",
    "Electric",
    "Strike"
}

local function DetectStorm()

    for _, obj in ipairs(Workspace:GetDescendants()) do

        local name = string.lower(obj.Name)

        for _, keyword in ipairs(StormNames) do

            if string.find(name, string.lower(keyword), 1, true) then
                return true
            end

        end

    end

    return false

end

--==================================================
-- HARVEST
--==================================================

local function Harvest()

    if not Settings.AutoHarvest then
        return
    end

    local Root = GetRoot()

    if not Root then
        return
    end

    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local Name = string.lower(obj.Name)

            local IsHarvest =
                string.find(Name, "harvest", 1, true)
                or string.find(Name, "collect", 1, true)
                or string.find(Name, "pick", 1, true)
                or string.find(Name, "thu", 1, true)

            if IsHarvest then

                local Part = obj.Parent

                if Part and Part:IsA("BasePart") then

                    local Distance =
                        (Root.Position - Part.Position).Magnitude

                    if Distance <= Settings.HarvestDistance then

                        pcall(function()
                            fireproximityprompt(obj)
                        end)

                        count += 1

                    end

                end

            end

        end

    end

    if count > 0 then
        Notify("🌱 Đã thu hoạch " .. count .. " cây")
    end

end

--==================================================
-- LIGHTNING LOOP
--==================================================

local LastStorm = false

task.spawn(function()

    while task.wait(Settings.ScanDelay) do

        if Settings.AutoLightning then

            local Storm = DetectStorm()

            if Storm and not LastStorm then

                LastStorm = true

                Notify("⚡ Phát hiện dấu hiệu sét!")

                task.wait(0.05)

                Harvest()

            elseif not Storm then

                LastStorm = false

            end

        end

    end

end)

